# DeepSeek / OpenAI-compatible chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# DashScope native API (embedding + rerank)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# Existing PostgreSQL with pgvector
DATABASE_URL=postgresql://user:password@host:5432/script_agent

# Knowledge base
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200

# DashScope reranker (native API)
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RERANK_CANDIDATE_K=30
RERANK_TOP_N=8
RERANK_TIMEOUT_SECONDS=20
RERANK_FALLBACK=true

# Runtime
APP_ENV=local
ENABLE_TEST_API=true
MAX_STEPS=12
MAX_TOOL_CALLS=12
MAX_REVISIONS=2
MAX_REWRITES=2
TOOL_TIMEOUT_SECONDS=10
